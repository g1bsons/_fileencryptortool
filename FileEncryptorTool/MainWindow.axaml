<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FileEncryptorTool.MainWindow"
        Title="Simple File Encryptor"
        Width="600"
        Height="350">

    <!-- Arranges the controls vertically  and creates sapces between the borders -->
    <StackPanel Margin="30">

        <!-- This it the title -->
        <TextBlock
            Text="Simple File Encryptor"
            FontSize="28"
            HorizontalAlignment="Center"
            Margin="0,0,0,30" />

        <!-- Opens the OS file manager -->
        <Button
            Name="SelectFileButton"
            Content="Select File"
            HorizontalAlignment="Left"
            Width="120"
            Click="SelectFileButton_Click" />

        <!-- Displays the selected file -->
        <TextBlock
            Name="SelectedFileText"
            Text="No file selected"
            Margin="0,10,0,25" />

        <!-- Prompts for a password -->
        <TextBlock
            Text="Password:" />

        <!-- Enter the password -->
        <!-- Characters are hidden while that happens -->
        <TextBox
            Name="PasswordTextBox"
            PasswordChar="*"
            Margin="0,5,0,25" />

        <!-- Orients the buttons horozontially not vertically -->
        <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Center">

            <!-- Allows for the encryption of the users chosen file -->
            <Button
                Name="EncryptButton"
                Content="Encrypt File"
                Width="150"
                Height="40"
                Margin="0,0,10,0"
                Click="EncryptButton_Click" />

            <!-- Allows for the decryption of the users chosen file -->
            <Button
                Name="DecryptButton"
                Content="Decrypt File"
                Width="150"
                Height="40"
                Click="DecryptButton_Click" />

        </StackPanel>

    </StackPanel>

</Window>